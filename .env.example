# AI Provider Configuration
# IMPORTANT: The AI API key is server-side only (Vercel environment variable)
# NEVER configure the API key in browser environment variables
# The serverless function at api/extract-task.ts handles the API key securely

# Vercel Environment Variables (set in Vercel dashboard, not in .env.local):
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# API Base URL (for custom proxy endpoints during local development)
# Leave empty to use relative path /api/extract-task
VITE_AI_API_BASE_URL=""
